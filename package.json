{
  "name": "ai-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Grid inventory: drops, stashes, trunks, shops, crafting, weapons; ox_inventory and qb-inventory compatible",
  "license": "GPL-3.0-only",
  "author": {
    "name": "ai-core"
  },
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "ai-core"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\" --ignore-pattern \"web/postcss-*.js\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "build": "bun run --cwd web build && aicore-db-types && bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json && tsc --noEmit -p resource/server/tsconfig.json",
    "webdev": "bun --cwd web vite",
    "bench": "bun bench/run.ts inventory"
  },
  "dependencies": {
    "@aicore-fivem/lib": "^0.1.0",
    "@aicore-fivem/shared": "^0.1.0",
    "@aicore-fivem/mysql": "^0.1.0"
  },
  "devDependencies": {
    "@aicore-fivem/build": "^0.1.0",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@overextended/core": "^0.3.1",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxProvide": [
    "ox_inventory",
    "qb-inventory"
  ],
  "fxFiles": [
    "data/items.json",
    "data/settings.json",
    "data/shops.json",
    "data/stashes.json",
    "data/benches.json"
  ]
}

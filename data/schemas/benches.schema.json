{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-inventory/data/benches.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Bench name",
          "type": "string",
          "minLength": 0,
          "maxLength": 48
        },
        "coords": {
          "description": "Place: Stand where players should open it and use your position.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "radius": {
          "description": "Reach: How close a player must be to open it.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "jobs": {
          "description": "Jobs: Only members of these jobs can use it. Leave jobs and gangs empty for everyone.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gangs": {
          "description": "Gangs: Members of these gangs can use it too.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "onDuty": {
          "description": "Only on duty: Job members must be on duty in that job.",
          "type": "boolean"
        },
        "recipes": {
          "description": "Recipes",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "result": {
                "description": "Makes",
                "type": "string",
                "minLength": 2,
                "maxLength": 48,
                "pattern": "^[a-z0-9_-]{2,48}$"
              },
              "count": {
                "description": "Amount",
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "time": {
                "description": "Time",
                "type": "number",
                "minimum": 0,
                "maximum": 600
              },
              "ingredients": {
                "description": "Materials",
                "type": "string",
                "minLength": 0,
                "maxLength": 400
              }
            },
            "required": [
              "result",
              "count",
              "time",
              "ingredients"
            ]
          }
        }
      },
      "required": [
        "label",
        "coords",
        "radius",
        "recipes"
      ]
    }
  },
  "additionalProperties": false
}

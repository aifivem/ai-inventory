{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-inventory/data/shops.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "ped": {
          "type": "object",
          "properties": {
            "model": {
              "description": "Model: The ped model; empty means no NPC. Players see it within 50 m.",
              "type": "string",
              "maxLength": 64
            },
            "scenario": {
              "description": "What it does: An idle animation the NPC plays on the spot.",
              "enum": [
                "",
                "WORLD_HUMAN_STAND_IMPATIENT",
                "WORLD_HUMAN_CLIPBOARD",
                "WORLD_HUMAN_STAND_MOBILE",
                "WORLD_HUMAN_AA_COFFEE",
                "WORLD_HUMAN_SMOKING",
                "WORLD_HUMAN_GUARD_STAND",
                "WORLD_HUMAN_COP_IDLES",
                "WORLD_HUMAN_HANG_OUT_STREET"
              ]
            },
            "coords": {
              "description": "Where it stands: The NPC's floor spot and the way it faces (scroll in the free camera); without one it stands on the place's point.",
              "type": "object",
              "required": [
                "x",
                "y",
                "z",
                "heading"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "heading": {
                  "type": "number"
                }
              }
            }
          },
          "required": []
        },
        "label": {
          "description": "Shop name",
          "type": "string",
          "minLength": 0,
          "maxLength": 48
        },
        "coords": {
          "description": "Place: Stand where players should open it and use your position.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "radius": {
          "description": "Reach: How close a player must be to open it.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "jobs": {
          "description": "Jobs: Empty lets everyone in; otherwise only characters with one of these jobs.",
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9_-]{2,48}$"
          }
        },
        "blip": {
          "description": "Map blip: Shows the shop on the map.",
          "type": "boolean"
        },
        "blipStyle": {
          "description": "Blip look: Picture, colour and size of the shop's map blip.",
          "type": "object",
          "properties": {
            "sprite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "scale": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 2
            }
          },
          "required": [
            "sprite",
            "color",
            "scale"
          ]
        },
        "accounts": {
          "description": "Paid from: Money accounts tried in order (cash, bank).",
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z0-9_]{2,32}$"
          }
        },
        "items": {
          "description": "Products",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "Item",
                "type": "string",
                "minLength": 2,
                "maxLength": 48,
                "pattern": "^[a-z0-9_-]{2,48}$"
              },
              "price": {
                "description": "Price",
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              }
            },
            "required": [
              "name",
              "price"
            ]
          }
        }
      },
      "required": [
        "label",
        "coords",
        "radius",
        "jobs",
        "blip",
        "blipStyle",
        "accounts",
        "items"
      ]
    }
  },
  "additionalProperties": false
}

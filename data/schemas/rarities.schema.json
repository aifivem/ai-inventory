{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-inventory/data/rarities.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_-]{2,48}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "color": {
          "description": "Colour: The box of every item of this rarity is tinted with it.",
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "label",
        "color"
      ]
    }
  },
  "additionalProperties": false
}
